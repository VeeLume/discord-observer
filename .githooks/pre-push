#!/usr/bin/env bash
set -euo pipefail

echo "▶ cargo fmt --check"
cargo fmt --all -- --check

echo "▶ cargo clippy"
cargo clippy --all-targets --all-features

echo "▶ cargo check"
cargo check --all-targets --all-features

# The Docker build compiles with SQLX_OFFLINE=true, so a stale .sqlx/ cache
# breaks the image build on the VPS. Fail the push instead.
echo "▶ cargo sqlx prepare --check"
cargo sqlx prepare --check

echo "✓ pre-push checks passed"
